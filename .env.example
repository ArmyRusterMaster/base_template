# Скопируй в .env (он в .gitignore) или пробрось в Docker/docker-compose.
# Полная документация: docs/configuration.md

# --- Конфигурация приложения (layer приоритетнее config/app.yaml) ---
APP_APP_NAME=base_template
APP_SERVER_HOST=0.0.0.0
APP_SERVER_PORT=3000

# --- Параметры Leptos (перекрывают значения из Cargo.toml [package.metadata.leptos]) ---
# LEPTOS_SITE_ROOT=target/site
# LEPTOS_SITE_ADDR=127.0.0.1:3000
# LEPTOS_OUTPUT_NAME=base_template